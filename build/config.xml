<!-- Panther2K config file -->
<!-- Generated by Panther2K version 2.0 -->
<!-- BETA FORMAT: Changes will most likely still be made -->
<Panther2KConfig>
    <!-- Uses the custom console to display Panther2K's user interface -->
    <Console>
        <!-- Define console colors here-->
        <BackgroundColor>
            <!-- You can supply RGB colors-->
            <RGB>0,0,170</RGB>
        </BackgroundColor>
        <ForegroundColor>
            <HEX>#AAAAAA</HEX>
        </ForegroundColor>
        <ErrorColor /> <!-- Use default -->
        <ProgressBarColor />
        <LightForegroundColor />
        <DarkForegroundColor />
        <Columns>80</Columns>
        <Rows/><!-- Again, use default (80x25) --> 
        <!-- Note, default options are only allowed in the Console section -->
    </Console>

   <!--All options below this line do nothing -->

    <!-- Specified how detailed the logfile should be -->
    <!--<LogLevel>basic</LogLevel>-->
    <LogLevel>normal</LogLevel>
    <!--<LogLevel>detailed</LogLevel>-->
    <!--<LogLevel>verbose</LogLevel>-->

    <!-- May be omitted -->
    <!-- WinPE behaves slightly differently from full Windows in terms of disk/volume functions so Panther2K has certain mitigations for that -->
    <!-- If present, Panther2K will always behave as if it were in the Windows Preinstallation Environment (mitigations enabled) -->
    <!-- This might slow down formatting operations -->
    <!--<WinPE />-->

    <!-- Specifies the location of the WIM or ESD file Panther2K uses -->
    <!-- Must be either Auto or a fully qualified path to a valid WIM or ESD image -->
    <!-- ESD images must have .esd extension (case insensitive) -->
    <WimFile>Auto</WimFile>

    <!-- Specifies the index of the image inside the WIM file to use -->
    <!-- Must be either Ask or a valid image index in WimFile -->
    <!-- WimFile may not be Auto -->
    <WimIndex>Ask</WimIndex>

    <!-- Specifies the method of booting to use -->
    <!-- Must be one of: Legacy, UEFI or Ask -->
    <BootMethod>Ask</BootMethod>

    <!-- Determines whether to set up the Windows Recovery Environment -->
    <!-- Requires an extra partition to set up -->
    <UseRecovery>True</UseRecovery>

    <!-- By default, Panther2K checks whether certain installation partitions have certain filesystems: -->
    <!-- System: NTFS,   Boot (UEFI): FAT32,   Boot (Legacy): NTFS,   Recovery: NTFS -->
    <!-- If this option is set to True, these checks are disabled -->
    <!-- Should only be used when installing Windows to normally unsupported filesystems (eg. Btrfs) -->
    <AllowOtherFilesystems>False</AllowOtherFilesystems>

    <!-- Panther2K supports two modes of operation: -->
    <!-- FullDisk: Uses an entire disk to install Windows. The entire disk will be formatted -->
    <!-- Custom: Uses individual partitions to install Windows. T-->
    <!-- Must be FullDisk, Custom or Ask -->
    <PartitionMethod>Ask</PartitionMethod>

    <!-- Config options for PartitionMethod FullDisk: -->
    <!-- Can be a disk number or Ask -->
    <!--<DiskNumber>0</DiskNumber>-->

    <!-- Config options for PartitionMethod Custom: -->
    <!--
    <SystemPartition>
        <Volume>\\?\Volume{aabbccdd-eeff-aabb-ccdd-eeffaabbccdd}</Volume>
    </SystemPartition>
    <BootPartition>
        <MountPoint>C:\</MountPoint>
    </BootPartition>
    <RecoveryPartition>
        <MountPoint>C:\Path\To\NTFS\Dir\MountPoint</MountPoint>
    </RecoveryPartition>
    -->
    <!-- RecoveryPartition is only valid if UseRecovery is True -->

    <!-- If PartitionMethod is Ask, no additional information may be provided. -->

    <!-- Determine whether to show filenames during installation -->
    <ShowFileNames>True</ShowFileNames>

    <!-- Determines how many characters of the file name should be displayed -->
    <!-- Must be at least 12 -->
    <!-- If equal to 12, Panther2K will automatically generate a DOS style 8.3 filename (eg: FILENAMEISLONG.ext -> FILENA~0.ext) -->
    <ShownFileNameLength>12</ShownFileNameLength>

    <!-- Determines whether to continue the installation if Windows RE failed to set up -->
    <AllowFailedRecovery>True</AllowFailedRecovery>

    <!-- Determines for how many seconds the final page should be displayed -->
    <!-- If this is less than 3, the final page is skipped entirely -->
    <!-- Note: if the setup fails, the final page is always displayed without any timer -->
    <RebootTimer>10</RebootTimer>
</Panther2KConfig>