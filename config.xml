<!-- Panther2K config file -->
<!-- Generated by Panther2K version 2.0 -->
<!-- BETA FORMAT: Changes will most likely still be made -->
<Panther2KConfig>
    <!-- Uses the custom console to display Panther2K's user interface -->
    <Console>
        <!-- Define console colors here-->
        <BackgroundColor>
            <!-- You can supply RGB colors-->
            <RGB>0,0,170</RGB>
        </BackgroundColor>
        <ForegroundColor>
            <HEX>#AAAAAA</HEX>
        </ForegroundColor>
        <ErrorColor /> <!-- Use default -->
        <ProgressBarColor />
        <LightForegroundColor />
        <DarkForegroundColor />
        <Columns>80</Columns>
        <Rows/><!-- Again, use default (80x25) --> 
        <!-- Note, default options are only allowed in the Console section -->
    </Console>

    <!--All options can be omitted to either use a default value, or ask the user -->

    <!-- Specified how detailed the logfile should be -->
    <!--<LogLevel>basic</LogLevel>-->
    <LogLevel>normal</LogLevel>
    <!--<LogLevel>detailed</LogLevel>-->
    <!--<LogLevel>verbose</LogLevel>-->

    <!-- Specifies the location of the WIM or ESD file Panther2K uses -->
    <!-- Must be a fully qualified path to a valid WIM or ESD image -->
    <!-- ESD images must have .esd extension (case insensitive) -->
	<!-- If omitted, Panther2K will automatically try to detect the 
	     image in standard paths on all disks -->
    <!--<WimFile>C:\path\to\wimfile</WimFile>-->

    <!-- Specifies the index of the image inside the WIM file to use -->
    <!-- Must be a valid image index in WimFile -->
    <!-- WimFile must be defined -->
    <!--<WimIndex>3</WimIndex>-->

    <!-- Specifies the method of booting to use -->
    <!-- Must be one of: Legacy, UEFI -->
    <!--<BootMethod>UEFI</BootMethod>-->

    <!-- By default, Panther2K checks whether certain installation partitions have certain filesystems: -->
    <!-- System: NTFS,   Boot (UEFI): FAT32,   Boot (Legacy): NTFS -->
    <!-- If this option is uncommented, these checks are disabled -->
    <!-- Should only be used when installing Windows to normally unsupported filesystems (eg. Btrfs) -->
    <!--<AllowOtherFilesystems/>-->

    <!-- Panther2K supports two modes of operation: -->
    <!-- FullDisk: Uses an entire disk to install Windows. The entire disk will be formatted. -->
    <!-- Custom: Automatically finds and creates required partitions, based on a selected system volume. -->
    <!-- Must be one of: FullDisk, Custom -->
    <!--<PartitionMethod>FullDisk</PartitionMethod>-->

    <!-- Config options for PartitionMethod FullDisk: -->
    <!-- Must be a disk number -->
    <!--<DiskNumber>0</DiskNumber>-->

    <!-- Config options for PartitionMethod Custom: -->
	<!-- Must be a fully qualified Win32 volume path -->
    <!--<SystemVolume>\\?\Volume{aabbccdd-eeff-aabb-ccdd-eeffaabbccdd}</SystemVolume>-->

    <!-- Determine whether to show filenames during installation -->
	<!-- Default: True -->
	<!-- Must be one of: True, False -->
    <ShowFileNames>True</ShowFileNames>

    <!-- Determines how many characters of the file name should be displayed -->
	<!-- Default: 12 -->
    <!-- Must be at least 12 -->
    <!-- If equal to 12, Panther2K will automatically generate a DOS style 8.3 filename (eg: FILENAMEISLONG.ext -> FILENA~0.ext) -->
    <ShownFileNameLength>12</ShownFileNameLength>

    <!-- Determines for how many seconds the final page should be displayed -->
    <!-- If this is less than 3, the final page is skipped entirely -->
    <!-- Note: if the setup fails, the final page is always displayed without any timer -->
    <RebootTimer>10</RebootTimer>
</Panther2KConfig>